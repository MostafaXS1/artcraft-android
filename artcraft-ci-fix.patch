diff --git a/lib/build-common.sh b/lib/build-common.sh
--- a/lib/build-common.sh
+++ b/lib/build-common.sh
@@ -447,5 +447,12 @@ source_tree_is_complete() {
     done | head -5)"
     [[ -z "$missing" ]]
 }
+# Git can leave an empty directory for a formerly tracked submodule (gitlink) after
+# .gitmodules and the gitlink are removed. This builder owns source checkouts, so remove
+# only an empty placeholder; never delete non-empty source trees or local changes.
+if [[ -d "$SRC" && ! -e "$SRC/.git" ]] &&
+   [[ -z "$(find "$SRC" -mindepth 1 -maxdepth 1 -print -quit)" ]]; then
+    rmdir "$SRC"
+fi
 if [[ -e "$SRC" ]]; then
     [[ -d "$SRC/.git" ]] || fail "$SRC exists but is not a Git checkout. Move it aside manually before retrying."
