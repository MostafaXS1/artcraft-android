# Build artifacts
build
build/
**/target/
output/
logs/
# keys/ is deliberately tracked to preserve signing identity and Android App UID across updates
.cargo-home/

# Source checkouts (cloned during build)
source/

# Backups
backups/

# Held by lib/build-common.sh while a build is running (one build at a time)
.artcraft-build.lock

# Gradle JDK the builder downloads when no suitable one is installed (lib/build-common.sh)
.cache/

# Android SDK the builder downloads when the machine has none (lib/build-common.sh)
android-sdk/

# Python bytecode caches
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# Local reversible snapshots (not part of the project)
.backups/
keys/*.jks
keys/.keystore-password

# ArtCraft Launcher (Android) build artifacts
artcraft-android-launcher/launcher/target/
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/app/build/
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/.gradle/
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/app/.cxx/
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/gradle.properties
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/local.properties
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/android/app/src/main/jniLibs/

# Gradle wrapper and cache
**/gradle/wrapper/dists/
**/.gradle/

# Cargo vendor patches (generated)
artcraft-android-launcher/launcher/vendor-egui-winit-*/
artcraft-android-launcher/launcher/apps/artcraft-launcher-android/target/

# Launcher output (built APKs)
output/Artcraft-launcher.apk
output/*.apk

# IDE and editor files
.idea/
.vscode/
*.iml
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.tmp/
temp/
